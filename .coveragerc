[run]
branch = True
source = src/tree_modeling
data_file = ~/localfiles/.coverage_tree_modeling

[report]
exclude_lines =
    if self.debug:
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:

ignore_errors = True
omit =
    tests/*
    setup.py
    # this file is autogenerated by dbx
    src/tree_modeling/common.py
